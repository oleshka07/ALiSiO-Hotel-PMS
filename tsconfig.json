{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@core/*": ["./src/core/*"],
      "@shared/*": ["./src/shared/*"],
      "@bookings": ["./src/modules/bookings/api"],
      "@bookings/*": ["./src/modules/bookings/api/*"],
      "@guests": ["./src/modules/guests/api"],
      "@guests/*": ["./src/modules/guests/api/*"],
      "@properties": ["./src/modules/properties/api"],
      "@properties/*": ["./src/modules/properties/api/*"],
      "@pricing": ["./src/modules/pricing/api"],
      "@pricing/*": ["./src/modules/pricing/api/*"],
      "@finance": ["./src/modules/finance/api"],
      "@finance/*": ["./src/modules/finance/api/*"],
      "@crm": ["./src/modules/crm/api"],
      "@crm/*": ["./src/modules/crm/api/*"],
      "@channels": ["./src/modules/channels/api"],
      "@channels/*": ["./src/modules/channels/api/*"],
      "@reports": ["./src/modules/reports/api"],
      "@reports/*": ["./src/modules/reports/api/*"],
      "@auth": ["./src/modules/auth/api"],
      "@auth/*": ["./src/modules/auth/api/*"],
      "@dashboard": ["./src/modules/dashboard/api"],
      "@dashboard/*": ["./src/modules/dashboard/api/*"],
      "@admin": ["./src/modules/admin/api"],
      "@admin/*": ["./src/modules/admin/api/*"],
      "@payments": ["./src/modules/payments/api"],
      "@payments/*": ["./src/modules/payments/api/*"],
      "@tasks": ["./src/modules/tasks/api"],
      "@tasks/*": ["./src/modules/tasks/api/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
