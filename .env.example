# ALiSiO PMS — Environment Variables
# Copy this file to .env.local and fill in values

NODE_ENV=production

# AI Assistant (required for ChatWidget)
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Google Sheets — Guest Registration Sync
# Google Apps Script Web App URL (same one used by the Telegram bot)
# GOOGLE_GUESTS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Bank Inbox — AES-256-GCM secret (32-byte hex) for encrypting IMAP passwords stored in DB
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BANK_INBOX_SECRET=...

# Telegram Bridge — shared secret the kemptimebot uses to authenticate
# its POST calls to /api/finance/telegram-bridge/operation. Generate the
# same way as BANK_INBOX_SECRET (any sufficiently long random hex).
# The bot must send `Authorization: Bearer <TELEGRAM_BRIDGE_TOKEN>`.
TELEGRAM_BRIDGE_TOKEN=...

# ── Server-Side Analytics (GA4 Measurement Protocol) ─────────────────────────
# Required to fire 'purchase' events from Teya webhook (server→Google).
# Find in GA4 → Admin → Data Streams → select stream → Measurement Protocol.
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# GA4_API_SECRET=your_secret_from_ga4

# ── Meta Conversions API ──────────────────────────────────────────────────────
# Required to fire 'Purchase' events to Facebook pixel server-side.
# META_PIXEL_ID=your_pixel_id
# META_ACCESS_TOKEN=your_system_user_access_token

